# Optional HTTPS in front of the app (install Caddy on the host, not in the app container).
# Replace example.com and point DNS A record to this EC2 Elastic IP.
#
# Install: https://caddyserver.com/docs/install
# Run: sudo caddy run --config /path/to/Caddyfile

example.com {
  reverse_proxy 127.0.0.1:3000
}
